<Window x:Class="Belajar_1.Components.NotificationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Width="380" Height="180" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Border Background="White" CornerRadius="8" BorderBrush="#DEE2E6" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="HeaderBar" Grid.Row="0" Height="4" CornerRadius="8,8,0,0" Background="#0D6EFD"/>

            <StackPanel Grid.Row="1" Margin="20" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtIcon" Text="⚠️" FontSize="28" Margin="0,0,15,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtMessage" Text="Pesan Notifikasi" FontSize="13" TextWrapping="Wrap" Width="280" VerticalAlignment="Center" Foreground="#333333"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="15">
                <Button x:Name="BtnCancel" Content="Batal" Width="85" Style="{StaticResource BtnSecondary}" Margin="0,0,8,0" Click="BtnCancel_Click" Visibility="Collapsed"/>
                <Button x:Name="BtnOk" Content="OK" Width="85" Style="{StaticResource BtnPrimary}" Click="BtnOk_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>