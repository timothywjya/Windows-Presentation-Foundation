<UserControl x:Class="Belajar_1.Components.Form.FormUser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comps="clr-namespace:Belajar_1.Components">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20" Background="White" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="8" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="PENGATURAN AKUN USER" FontSize="16" FontWeight="Bold" Foreground="#212529" Margin="0,0,0,15"/>

                <UniformGrid Columns="2">
                    <StackPanel Margin="10,0">
                        <TextBlock Text="User ID" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtUserId" Height="32" VerticalContentAlignment="Center" Padding="5,0"/>

                        <TextBlock Text="Username" FontWeight="SemiBold" Margin="0,15,0,5"/>
                        <TextBox x:Name="TxtUsername" Height="32" VerticalContentAlignment="Center" Padding="5,0"/>
                    </StackPanel>

                    <StackPanel Margin="10,0">
                        <TextBlock Text="Email Address" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtEmail" Height="32" VerticalContentAlignment="Center" Padding="5,0"/>

                        <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,15,0,5"/>
                        <PasswordBox x:Name="TxtPassword" Height="32" VerticalContentAlignment="Center" Padding="5,0"/>
                    </StackPanel>
                </UniformGrid>

                <UniformGrid Columns="2" Margin="10,15,10,0">
                    <StackPanel>
                        <TextBlock Text="User Level" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtLevel" Height="32" Width="100" HorizontalAlignment="Left" VerticalContentAlignment="Center" Padding="5,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <Button Content="Reset" Style="{StaticResource BtnSecondary}" Width="90" Margin="5,0" Click="BtnClear_Click"/>
                        <Button Content="Hapus" Style="{StaticResource BtnDanger}" Width="90" Margin="5,0" Click="BtnDelete_Click"/>
                        <Button Content="Update" Style="{StaticResource BtnSuccess}" Width="90" Margin="5,0" Click="BtnUpdate_Click"/>
                        <Button Content="Tambah User" Style="{StaticResource BtnPrimary}" Width="110" Margin="5,0" Click="BtnAdd_Click"/>
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <comps:Datatable x:Name="GridUser"/>
        </Grid>
    </Grid>
</UserControl>