<Window x:Class="Belajar_1.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login to OMI SYSTEM" Height="400" Width="350"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F8F9FA">

    <Border Padding="30" VerticalAlignment="Center">
        <StackPanel>
            <!-- Logo / Header -->
            <TextBlock Text="OMI SYSTEM" FontSize="26" FontWeight="Bold" Foreground="#212529" HorizontalAlignment="Center"/>
            <TextBlock Text="Our Beloved Franchise" FontSize="11" Foreground="#6C757D" HorizontalAlignment="Center" Margin="0,4,0,25"/>

            <!-- Input Username -->
            <TextBlock Text="Username / User ID" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#495057"/>
            <TextBox x:Name="TxtUsername" Height="35" VerticalContentAlignment="Center" Padding="5" Margin="0,0,0,15"/>

            <!-- Input Password -->
            <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#495057"/>
            <PasswordBox x:Name="TxtPassword" Height="35" VerticalContentAlignment="Center" Padding="5" Margin="0,0,0,25"/>

            <!-- Tombol Login -->
            <Button Content="LOGIN" Height="40" FontSize="14" FontWeight="Bold" 
                    Style="{StaticResource BtnPrimary}" Click="BtnLogin_Click" IsDefault="True"/>
        </StackPanel>
    </Border>
</Window>