<UserControl x:Class="Belajar_1.Components.Form.FormProduk"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comps="clr-namespace:Belajar_1.Components"
             xmlns:helpers="clr-namespace:Belajar_1.Helpers"
             xmlns:domain="clr-namespace:Belajar_1.Domain.Interfaces">

    <UserControl.Resources>
        <helpers:EmptyStringToVisibilityConverter x:Key="EmptyToVisibility"/>
        <ObjectDataProvider x:Key="SearchFieldValues" MethodName="GetValues" ObjectType="{x:Type domain:ProductSearchField}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="domain:ProductSearchField"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- ==== KIRI: Daftar produk + pencarian ==== -->
        <Border Grid.Column="0" Margin="0,0,15,0" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="6" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#F8F9FA" Padding="12" BorderBrush="#DEE2E6" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="Daftar PLU / Produk Terdaftar" FontWeight="Bold" Foreground="#495057" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0" Width="130" Height="30" VerticalContentAlignment="Center" Margin="0,0,6,0"
                                      ItemsSource="{Binding Source={StaticResource SearchFieldValues}}"
                                      SelectedItem="{Binding SearchField}"/>

                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Watermark "Ketik kata kunci..." kini murni lewat binding (lihat EmptyStringToVisibilityConverter),
                                     bukan trik GotFocus/LostFocus di code-behind seperti versi lama. -->
                                <Grid Grid.Column="0">
                                    <TextBox x:Name="TxtSearch" Height="30" VerticalContentAlignment="Center" Padding="5,0"
                                             Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                             KeyDown="TxtSearch_KeyDown"/>
                                    <TextBlock Text="Ketik kata kunci..." Foreground="Gray" Margin="8,0,0,0"
                                               VerticalAlignment="Center" IsHitTestVisible="False"
                                               Visibility="{Binding SearchKeyword, Converter={StaticResource EmptyToVisibility}}"/>
                                </Grid>

                                <Button Grid.Column="1" Content="Cari" Width="55" Height="30" Margin="5,0,0,0"
                                        Style="{StaticResource BtnPrimary}" Command="{Binding SearchCommand}"/>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">
                    <comps:Datatable ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ==== KANAN: Form detail produk ==== -->
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Border Padding="20" Background="White" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="DATA PRODUK DETAIL" FontSize="16" FontWeight="Bold" Foreground="#212529" Margin="0,0,0,15"/>

                    <UniformGrid Columns="2" Margin="0,0,0,10">
                        <StackPanel Margin="5,0">
                            <TextBlock Text="Kode PLU" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Height="30" VerticalContentAlignment="Center"
                                     Text="{Binding Kode, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsKodeEditable}"/>
                        </StackPanel>
                        <StackPanel Margin="5,0">
                            <TextBlock Text="Merek" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Height="30" VerticalContentAlignment="Center" Text="{Binding Merk, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </UniformGrid>

                    <UniformGrid Columns="2" Margin="0,0,0,10">
                        <StackPanel Margin="5,0">
                            <TextBlock Text="Nama Barang" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Height="30" VerticalContentAlignment="Center" Text="{Binding Nama, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="5,0">
                            <TextBlock Text="Rasa" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Height="30" VerticalContentAlignment="Center" Text="{Binding Flavour, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </UniformGrid>

                    <UniformGrid Columns="3" Margin="0,0,0,10">
                        <StackPanel Margin="5,0">
                            <TextBlock Text="Kemasan" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Height="30" VerticalContentAlignment="Center" Text="{Binding Kemasan, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="5,0">
                            <TextBlock Text="Ukuran" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Height="30" VerticalContentAlignment="Center" Text="{Binding Size, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="5,0">
                            <TextBlock Text="Deskripsi" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Height="30" VerticalContentAlignment="Center" Text="{Binding Deskripsi, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </UniformGrid>

                    <UniformGrid Columns="2" Margin="0,0,0,10">
                        <StackPanel Margin="5,0">
                            <TextBlock Text="Unit Satuan" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Height="30" VerticalContentAlignment="Center" Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="5,0">
                            <TextBlock Text="Frac / Unit" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Height="30" VerticalContentAlignment="Center" Text="{Binding FracText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </UniformGrid>

                    <UniformGrid Columns="2" Margin="0,0,0,10">
                        <StackPanel Margin="5,0">
                            <TextBlock Text="Harga Jual" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Height="30" VerticalContentAlignment="Center" Text="{Binding HargaJualText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="5,0">
                            <TextBlock Text="Harga Usulan" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Height="30" VerticalContentAlignment="Center" Text="{Binding HargaJual2Text, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC3545" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="5,0,5,0"/>

                    <Separator Margin="5,10" Background="#DEE2E6"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,5,0">
                        <Button Content="Batal / Reset" Style="{StaticResource BtnSecondary}" Width="100" Margin="5,0" Command="{Binding ClearCommand}"/>
                        <Button Content="Hapus" Style="{StaticResource BtnDanger}" Width="90" Margin="5,0" Click="BtnDelete_Click"/>
                        <Button Content="Simpan / Update" Style="{StaticResource BtnSuccess}" Width="120" Margin="5,0" Command="{Binding UpdateCommand}"/>
                        <Button Content="Tambah Baru" Style="{StaticResource BtnPrimary}" Width="110" Margin="5,0" Command="{Binding AddCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
