<UserControl x:Class="Belajar_1.Components.Form.FormSupplier"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comps="clr-namespace:Belajar_1.Components">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="15" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="6" Margin="0,0,0,15">
            <StackPanel>
                <UniformGrid Columns="5" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <TextBlock Text="Kode Supplier" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Height="30" VerticalContentAlignment="Center"
                                 Text="{Binding Kode, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsKodeEditable}"/>
                    </StackPanel>
                    <StackPanel Margin="5">
                        <TextBlock Text="Nama Supplier" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Height="30" VerticalContentAlignment="Center"
                                 Text="{Binding Nama, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Margin="5">
                        <TextBlock Text="Singkatan" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Height="30" VerticalContentAlignment="Center"
                                 Text="{Binding Singkatan, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Margin="5">
                        <TextBlock Text="Telepon" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Height="30" VerticalContentAlignment="Center"
                                 Text="{Binding Telepon, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Margin="5">
                        <TextBlock Text="Contact Person" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Height="30" VerticalContentAlignment="Center"
                                 Text="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </UniformGrid>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC3545" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="5,0,5,10"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Reset" Style="{StaticResource BtnSecondary}" Width="90" Margin="5,0" Command="{Binding ClearCommand}"/>
                    <Button Content="Tambah" Style="{StaticResource BtnPrimary}" Width="90" Margin="5,0" Command="{Binding AddCommand}"/>
                    <Button Content="Simpan" Style="{StaticResource BtnSuccess}" Width="90" Margin="5,0" Command="{Binding UpdateCommand}"/>
                    <Button Content="Hapus" Style="{StaticResource BtnDanger}" Width="90" Margin="5,0" Click="BtnDelete_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <comps:Datatable ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"/>
        </Grid>
    </Grid>
</UserControl>
