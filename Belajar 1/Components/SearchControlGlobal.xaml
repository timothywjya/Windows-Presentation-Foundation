<UserControl x:Class="Belajar_1.Components.SearchControlGlobal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="32">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <ComboBox x:Name="CmbType" Grid.Column="0" Width="120" VerticalContentAlignment="Center" Margin="0,0,5,0"/>

        <TextBox x:Name="TxtKeyword" Grid.Column="1" VerticalContentAlignment="Center" Padding="6,0"
                 GotFocus="TxtKeyword_GotFocus" LostFocus="TxtKeyword_LostFocus" KeyDown="TxtKeyword_KeyDown"/>

        <Button x:Name="BtnSearch" Grid.Column="2" Content="Cari" Width="60" Margin="5,0,0,0"
                Style="{StaticResource BtnPrimary}" Click="BtnSearch_Click"/>
    </Grid>
</UserControl>