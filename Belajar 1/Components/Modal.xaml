<UserControl x:Class="Belajar_1.Components.Modal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="ModalRoot" Visibility="Collapsed">
    <Grid Background="#80000000">
        <Border Width="850" Height="500" Background="White" CornerRadius="12" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" Color="Black" Opacity="0.2" ShadowDepth="0"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="20" BorderBrush="#DEE2E6" BorderThickness="0,0,0,1">
                    <Grid>
                        <TextBlock x:Name="TxtTitle" Text="Bootstrap Modal" FontSize="18" FontWeight="Bold" Foreground="#212529" VerticalAlignment="Center"/>
                        <Button Content="×" HorizontalAlignment="Right" Background="Transparent" FontSize="26" Foreground="#6C757D" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Padding="20">
                    <ContentControl x:Name="ModalBody" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>