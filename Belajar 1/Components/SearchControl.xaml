<UserControl x:Class="Belajar_1.Components.SearchControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="35">
    <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ComboBox x:Name="CmbSearchType" Width="130" Height="28" 
                      VerticalContentAlignment="Center" Margin="0,0,5,0">
                <ComboBoxItem Content="Kode PLU" Tag="PRD_PRDCD" IsSelected="True"/>
                <ComboBoxItem Content="Deskripsi / Nama" Tag="PRD_DESKRIPSI"/>
            </ComboBox>

            <TextBox x:Name="TxtSearch" Width="200" Height="28" 
                     VerticalContentAlignment="Center" Padding="5,0" Margin="0,0,5,0"
                     GotFocus="TxtSearch_GotFocus" LostFocus="TxtSearch_LostFocus"
                     KeyDown="TxtSearch_KeyDown"/>

            <Button x:Name="BtnSearch" Content="Cari" Width="60" Height="28" 
                    Style="{StaticResource BtnPrimary}" Click="BtnSearch_Click"/>
        </StackPanel>
    </Grid>
</UserControl>