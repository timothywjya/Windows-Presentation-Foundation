<Window x:Class="Belajar_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OMI MASTER DASHBOARD" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F8F9FA">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#212529" Padding="15,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="10,0,10,35">
                    <TextBlock Text="OMI SYSTEM" FontSize="22" FontWeight="Bold" Foreground="#DEFF9A"/>
                    <TextBlock Text="Indogrosir &amp; Indomaret Division" FontSize="11" Foreground="#6C757D" Margin="0,4,0,0"/>
                </StackPanel>

                <!--
                    Ketiga tombol menu di-bind ke SATU Command (NavigateCommand)
                    dengan CommandParameter berbeda — menggantikan 3 event
                    handler terpisah (MenuProduk_Click, dst) di code-behind.
                    Menu Retur sudah dihapus.
                -->
                <StackPanel Grid.Row="1" VerticalAlignment="Top">
                    <Button Content="📦    Master Produk" Style="{StaticResource BtnPrimary}"
                            Width="230" HorizontalAlignment="Center" Margin="0,4"
                            Command="{Binding NavigateCommand}" CommandParameter="produk"/>

                    <Button Content="🏭    Master Supplier" Style="{StaticResource BtnSuccess}"
                            Width="230" HorizontalAlignment="Center" Margin="0,4"
                            Command="{Binding NavigateCommand}" CommandParameter="supplier"/>

                    <Button Content="👤    Master User" Style="{StaticResource BtnSecondary}"
                            Width="230" HorizontalAlignment="Center" Margin="0,4"
                            Command="{Binding NavigateCommand}" CommandParameter="user"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="v1.1.0 © 2026 Internal App (Clean Architecture + MVVM)" FontSize="10"
                           Foreground="#495057" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" Padding="25,0" BorderBrush="#DEE2E6" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Dashboard" Foreground="#6C757D" FontSize="14"/>
                        <TextBlock Text=" / " Foreground="#6C757D" FontSize="14"/>
                        <TextBlock Text="{Binding PageTitle}" Foreground="#212529" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Width="8" Height="8" Background="#198754" CornerRadius="4" Margin="0,0,8,0"/>
                        <TextBlock Text="Developer Mode" FontSize="13" FontWeight="Medium" Foreground="#495057"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Konten halaman kini murni lewat Binding ke CurrentView, bukan
                 di-set manual dari code-behind (MainContentFrame.Content = ...). -->
            <Border Grid.Row="1" Padding="25">
                <ContentControl Content="{Binding CurrentView}"/>
            </Border>
        </Grid>

    </Grid>
</Window>
